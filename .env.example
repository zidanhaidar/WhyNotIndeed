# Copy this file to .env and fill it in before running docker compose. Never commit the real .env.
# Only POSTGRES_PASSWORD is required (use something long and random, for example: openssl rand -hex 24).
# Anything left empty uses the default shown in brackets.

# Database name and user (wni)
POSTGRES_DB=
POSTGRES_USER=
# Database password (required)
POSTGRES_PASSWORD=
# Port on your computer for the website (8080)
APP_PORT=
# Set both to true when WNI sits behind HTTPS and a reverse proxy (false)
COOKIE_SECURE=
TRUST_PROXY=
